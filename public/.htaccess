RewriteEngine On
RewriteBase /

# ── SPA fallback ─────────────────────────────────────────────────────────────
# Passe index.html directement
RewriteRule ^index\.html$ - [L]

# Renvoie 404 pour tout fichier statique manquant (extension connue + fichier absent).
# Sans cette règle, un ancien bundle JS supprimé lors d'un redéploiement recevrait
# du HTML au lieu d'un vrai échec, empêchant l'ErrorBoundary de relancer la page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} \.(js|mjs|css|json|svg|png|jpg|jpeg|webp|gif|ico|woff2|woff|ttf|eot|avif|map)$ [NC]
RewriteRule ^ - [R=404,L]

# Fallback SPA : uniquement pour les routes de navigation (URLs sans extension)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ── Types MIME ────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType application/json       .json
    AddType image/svg+xml          .svg
</IfModule>

# ── Cache-Control ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # index.html : jamais mis en cache (le navigateur revalide à chaque visite)
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Fichiers de traduction : revalidation obligatoire
    <FilesMatch "^.*\.json$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Assets hashés : cache permanent (Vite change le nom à chaque build)
    <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpg|jpeg|gif|ico|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
